# Maintainer: open-island contributors
pkgname=open-island-git
pkgver=0.1.0
pkgrel=1
pkgdesc='A macOS-style dynamic island for Wayland desktops (and Windows, macOS)'
arch=('x86_64' 'aarch64')
url='https://github.com/open-island/open-island'
license=('MIT')
depends=('vulkan-icd-loader' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'git')
optdepends=('wireplumber: volume (wpctl)' 'libpulse: audio outputs, microphone indicator, spectrum (pactl, parec)'
            'networkmanager: Wi-Fi toggle' 'bluez-utils: Bluetooth toggle' 'brightnessctl: brightness'
            'wl-clipboard: clipboard history' 'wlsunset: night light' 'pipewire: screen-share indicator (pw-dump)'
            'libnotify: notify-send for testing')
source=("git+$url.git")
sha256sums=('SKIP')

build() {
  cd open-island
  cargo build --release --locked -p open-island
}

check() {
  cd open-island
  cargo test --release --locked --workspace
}

package() {
  cd open-island
  install -Dm755 target/release/open-island "$pkgdir/usr/bin/open-island"
  install -Dm644 contrib/open-island.service "$pkgdir/usr/lib/systemd/user/open-island.service"
  sed -i 's|%h/.cargo/bin/open-island|/usr/bin/open-island|' "$pkgdir/usr/lib/systemd/user/open-island.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
